# Settings for the web version on a server. Copy this file to .env and fill it in:
#   cp .env.example .env
# .env is ignored by git: never commit it.

# Use the production setup for every "docker compose" command in this folder,
# so "docker compose up -d" is enough (no need for -f compose.yaml -f compose.prod.yaml).
COMPOSE_FILE=compose.yaml:compose.prod.yaml

# --- Needed by compose.prod.yaml (HTTPS + password) ---------------------------

# The address people open. Its DNS "A" record must point to this server's IP.
FLASH_DOMAIN=flash.example.com

# The login for the whole site.
FLASH_USER=student

# The password, hashed (never the password itself). Make the hash with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your password'
# Keep the single quotes: the hash contains "$" signs.
FLASH_PASSWORD_HASH='$2a$14$replace.this.with.the.output.of.caddy.hash.password'

# --- Optional limits (empty = the default shown) -----------------------------

# Largest file a user may upload, in MB (default 50). nginx also stops anything over 50 MB.
FLASH_MAX_UPLOAD_MB=
# How many unfinished tests are kept in memory; the oldest go first (default 1000).
FLASH_MAX_OPEN_TESTS=
# An open test nobody touched for this many hours is forgotten (default 6).
FLASH_TEST_IDLE_HOURS=
# DEBUG, INFO, WARNING or ERROR (default INFO).
FLASH_LOG_LEVEL=
